# Railway API configuration. Generate independent random values for each secret.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
REPORT_EMAIL_DOMAIN=example.org
WORKER_ENABLED=true

# Optional near-real-time lifecycle delivery to the bot over Railway private networking.
BOT_EVENT_WEBHOOK_URL=http://discord-bot.railway.internal:3000/internal/report-events
BOT_EVENT_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Sticky residential proxy template. Both placeholders are required.
# Keep the completed URL and credentials out of source control.
DSA_PROXY_URL_TEMPLATE=http://user-SUBUSER-region-{country}-sess-{session}-sessTime-120:PASSWORD@gate-eu.ipoasis.com:8668

# Optional local diagnostics using a single already-completed proxy URL.
DSA_PROXY_URL=http://user-SUBUSER-region-DE-sess-RANDOM-sessTime-120:PASSWORD@gate-eu.ipoasis.com:8668

# Optional, temporary values for header ablation. Never commit real values.
DSA_FINGERPRINT=
DSA_INSTALLATION_ID=
DSA_SUPER_PROPERTIES=
DSA_TEST_TIMEZONE=Europe/Berlin

# Optional diagnostic narrowing.
DSA_TEST_FLOW=message_urf
DSA_TEST_PROFILES=fingerprint_no_accept,fingerprint_only,fingerprint_installation
