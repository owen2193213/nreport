# New API service. Do not reuse values or databases from the historical deployment.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway

# Administrator access and personal-key hashing. Generate independent random values.
NREPORT_ADMIN_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
API_KEY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# API-owned report preparation.
AI_API_KEY=REPLACE_WITH_AI_API_KEY
AI_MODEL=deepseek/deepseek-v4-flash-0731
BRAVE_SEARCH_API_KEY=REPLACE_WITH_BRAVE_SEARCH_API_KEY
PREPARATION_CONCURRENCY=2

# Dedicated email route and lifecycle workers for this deployment.
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
REPORT_EMAIL_DOMAIN=reports-new.example.org
LIFECYCLE_CONCURRENCY=2
WORKER_ENABLED=true
OPERATIONS_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_PRIVATE_OPERATIONS_WEBHOOK

# Permit administrator-created http://*.railway.internal destinations. Public destinations
# must use HTTPS. Leave false when private Railway delivery is not needed.
ALLOW_RAILWAY_PRIVATE_HTTP_WEBHOOKS=true

# Sticky residential proxy template. Both placeholders are required.
DSA_PROXY_URL_TEMPLATE=http://user-SUBUSER-region-{country}-sess-{session}-sessTime-120:PASSWORD@gate-eu.ipoasis.com:8668
