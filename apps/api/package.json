{
  "name": "@nreport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build -w @nreport/observability",
    "dev": "node --import @nreport/observability/instrument-api --import tsx/esm --watch src/main.ts",
    "repair:report-flow": "tsx src/repair-report-flow.ts",
    "start": "node --enable-source-maps --import @nreport/observability/instrument-api dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test"
  },
  "dependencies": {
    "@discord-dsa/client": "0.1.0",
    "@faker-js/faker": "^10.5.0",
    "@fastify/rate-limit": "^11.1.0",
    "@nreport/contracts": "0.1.0",
    "@nreport/observability": "0.1.0",
    "@sindresorhus/transliterate": "^2.3.1",
    "fastify": "^5.12.1",
    "mailparser": "^3.9.20",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/pg": "^8.20.0"
  }
}
