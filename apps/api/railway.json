{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @nreport/contracts && npm run build -w @discord-dsa/client && npm run build -w @nreport/api",
    "watchPatterns": [
      "apps/api/**",
      "packages/discord-dsa-client/**",
      "packages/report-contracts/**",
      "package.json",
      "package-lock.json",
      "tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start -w @nreport/api",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
