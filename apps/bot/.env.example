# Discord user-installed app
NODE_ENV=production
PORT=3000
DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_ADMIN_USER_IDS=123456789012345678,234567890123456789

# Access control is enabled unless explicitly set to false.
WHITELIST_ENABLED=true
ACCESS_KEY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BOT_DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Use a bot-dedicated PostgreSQL service.
BOT_DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway

# The bot talks only to the authenticated DSA HTTP API.
DSA_API_BASE_URL=https://discord-dsa-production.up.railway.app
DSA_API_KEY=REPLACE_WITH_THE_API_SERVICE_API_KEY

# AI Provider: "openrouter" or "baseten"
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Alternatively, Baseten can be used if AI_PROVIDER=baseten:
BASETEN_API_KEY=REPLACE_WITH_BASETEN_API_KEY
BASETEN_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Brave performs conditional terminology and country-specific legal research.
BRAVE_SEARCH_API_KEY=REPLACE_WITH_BRAVE_SEARCH_API_KEY

# Use the same value as the API service's BOT_EVENT_WEBHOOK_SECRET.
REPORT_EVENT_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

