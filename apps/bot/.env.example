# New Discord user-installed application. Do not reuse the historical bot token or database.
NODE_ENV=production
PORT=3000
DISCORD_BOT_TOKEN=REPLACE_WITH_NEW_DISCORD_BOT_TOKEN
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_ADMIN_USER_IDS=123456789012345678,234567890123456789
BOT_DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
BOT_DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# The administrator key is used only by allow-listed Discord admin commands. Ordinary
# report operations use each connected user's encrypted personal API key.
DSA_API_BASE_URL=https://new-discord-dsa-api.example
DSA_ADMIN_API_KEY=REPLACE_WITH_THE_API_ADMINISTRATOR_KEY

# Set this only when the API destination is configured to call the bot webhook.
REPORT_EVENT_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
