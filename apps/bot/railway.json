{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @nreport/observability && npm run build -w @nreport/contracts && npm run build -w @nreport/discord-dsa-bot",
    "watchPatterns": [
      "apps/bot/**",
      "packages/observability/**",
      "packages/report-contracts/**",
      "scripts/patch-discordjs-poll.mjs",
      "package.json",
      "package-lock.json",
      "tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start -w @nreport/discord-dsa-bot",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
