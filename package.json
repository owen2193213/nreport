{
  "name": "nreport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @nreport/contracts && npm run build -w @discord-dsa/client && npm run build -w @nreport/api && npm run build -w @nreport/discord-dsa-bot --if-present",
    "start": "npm run start -w @nreport/api",
    "dev:api": "npm run dev -w @nreport/api",
    "dev:bot": "npm run dev -w @nreport/discord-dsa-bot",
    "lint": "eslint --no-error-on-unmatched-pattern \"apps/**/*.ts\" \"packages/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @discord-dsa/client",
    "test": "vitest run",
    "audit:high": "npm audit --audit-level=high",
    "test:client-readonly": "tsx scripts/test-client-readonly.ts",
    "test:post-headers": "tsx scripts/test-post-headers.ts",
    "test:headers": "tsx scripts/test-menu-headers.ts"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  }
}
