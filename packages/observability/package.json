{
  "name": "@nreport/observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./instrument-api": {
      "types": "./src/instrument-api.ts",
      "import": "./dist/instrument-api.js"
    },
    "./instrument-bot": {
      "types": "./src/instrument-bot.ts",
      "import": "./dist/instrument-bot.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test"
  },
  "dependencies": {
    "@sentry/node": "10.76.2"
  }
}
